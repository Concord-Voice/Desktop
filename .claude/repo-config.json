{
  "default_branch": "main",
  "hooks": {
    "protected_patterns": [
      "/crypto",
      "/e2ee",
      "mediaEncryption",
      "/auth/",
      "/mfa/",
      "/rbac/",
      "/password",
      "tokenManager",
      "/middleware/(auth|security|cors|ratelimit)",
      "desktop/src/preload/",
      "desktop/src/main/ipc",
      "desktop/src/main/oauth/",
      "\\.github/workflows/",
      "infrastructure/",
      "scripts/security/",
      "CODEOWNERS$",
      "desktop/src/main/secureStorage",
      "desktop/src/main/ssoLoopback",
      "/\\.claude/(hooks/|settings\\.json|repo-config\\.json)",
      "scripts/repo-config\\.sh$"
    ]
  }
}
