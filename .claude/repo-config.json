{
  "default_branch": "main",
  "paths": {
    "electron_dir": "desktop"
  },
  "hooks": {
    "protected_patterns": [
      "/crypto",
      "/e2ee",
      "mediaEncryption",
      "/auth/",
      "/rbac/",
      "tokenManager",
      "desktop/src/preload/",
      "desktop/src/main/ipc",
      "desktop/src/main/oauth/",
      "desktop/src/main/(secureStorage|ssoLoopback|browserWindowConfig|spaLoader|egressPolicy|guardedRequest|permissionManager|appProtocol|deepLink|attestation|selfHostedApprovals)",
      "desktop/src/main/(updater|updateSafety|verifyLinuxSignature|verifyWindowsSignature|linuxUpdatePublicKey)\\.ts$",
      "desktop/forge\\.config\\.ts$",
      "desktop/scripts/(generate-update-manifest|generate-app-update|sign-spa-manifest|csp-prod-strip)",
      "\\.github/workflows/",
      "\\.github/scripts/",
      "\\.pre-commit-config\\.yaml$",
      "\\.secrets\\.baseline$",
      "infrastructure/",
      "scripts/security/",
      "CODEOWNERS$",
      "(^|/)\\.claude/(hooks/|settings\\.json|repo-config\\.json|\\.agentic-dev-tooling\\.lock$|state/hook-bypass/)",
      "scripts/repo-config\\.sh$"
    ]
  },
  "feedback_triage": {
    "public": "Concord-Voice/Feedback",
    "tracker": "Concord-Voice/Desktop",
    "routing": {
      "desktop": "Concord-Voice/Desktop",
      "mobile": "Concord-Voice/Mobile",
      "self-hosted": "Concord-Voice/Self-Hosted"
    },
    "sentinel_prefix": "concord-feedback-triage"
  },
  "review_coverage": {
    "reviewer_bots": [
      "gitar-bot[bot]",
      "chatgpt-codex-connector[bot]"
    ]
  },
  "bots": [
    {
      "match": "gitar",
      "name": "Gitar",
      "login": "gitar-bot[bot]",
      "ci_check": "Gitar",
      "blocking": true,
      "offline": false,
      "when": "always",
      "ack_pattern": "(?s)\\A(?=(?:[ \\t]*>[^\\n]*\\n)*?[ \\t]*>[^\\n]*gitar)(?>(?:[ \\t]*>[^\\n]*(?:\\n|\\z))*)(?>\\s*)(?:\\*\\*|_)?(?:review (?:queued|started)|starting (?:a |the )?review(?: now)?|on it[^\\n]{0,8}running a review now|i.m re-?(?:checking|reviewing)(?: (?:the latest (?:commit|changes)|this (?:pr|pull request)))?(?: now)?)(?:[.;:,!]\\s*(?:the )?(?:results|findings) will (?:appear|show up|post) in the dashboard comment(?: (?:once|when) it (?:completes|finishes))?)?[.!]?(?:\\*\\*|_)?\\s*\\z",
      "decline_pattern": "(?s)\\A(?>(?:[ \\t]*>[^\\n]*(?:\\n|\\z)|[ \\t\\r]*\\n)*)(?!.*<summary><b>Code Review</b>).*?(?:sent several Gitar comments|wait about [0-9]+ minutes and comment again)"
    },
    {
      "match": "sonarqubecloud",
      "name": "SonarCloud",
      "login": "sonarqubecloud[bot]",
      "ci_check": "SonarCloud Code Analysis",
      "blocking": true,
      "when": "always"
    },
    {
      "name": "Semgrep SAST",
      "login": "github-actions[bot]",
      "marker": "<!-- semgrep-results -->",
      "ci_check": "Protected scan enforcement / semgrep / Semgrep SAST",
      "when": "always"
    },
    {
      "match": "copilot",
      "name": "Copilot Code Review",
      "login": [
        "copilot-pull-request-reviewer[bot]",
        "Copilot"
      ],
      "when": "active",
      "offline": true
    },
    {
      "match": "chatgpt-codex-connector",
      "name": "Codex",
      "login": "chatgpt-codex-connector[bot]",
      "when": "always",
      "ack_pattern": "(?s)<!-- codex-pull-request-review-summary -->.*\\*\\*Running\\*\\*",
      "head_verdict_pattern": "\\*\\*Completed\\*\\*[^|\\n]*\\|\\s*`([0-9a-f]{7,40})`",
      "decline_pattern": "codex usage limit|usage limits? (have|has) been reached|reached your (codex )?usage limit|Codex Review: Something went wrong"
    }
  ]
}
