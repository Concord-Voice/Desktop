{
  "name": "@concordvoice/desktop",
  "version": "0.1.10",
  "description": "Concord Voice Desktop Client - Privacy-first voice communication",
  "main": "dist/main/main.js",
  "author": "Concord Voice Team",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "npm run build:preload && tsc -p tsconfig.main.json && NODE_ENV=development electron-forge start",
    "build": "npm run build:renderer && npm run build:preload && npm run build:main",
    "build:renderer": "vite build",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:main": "tsc -p tsconfig.main.json",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "electron-squirrel-startup": "^1.0.0",
    "electron-updater": "^6.8.3",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^0.577.0",
    "mediasoup-client": "^3.18.7",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "socket.io-client": "^4.8.3",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron-forge/plugin-webpack": "^7.11.1",
    "@playwright/test": "^1.58.2",
    "@reforged/maker-appimage": "^5.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.0",
    "concurrently": "^9.2.1",
    "electron": "^41.0.2",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^29.0.0",
    "msw": "^2.12.11",
    "prettier": "^3.8.1",
    "typescript": "^5.3.3",
    "unicode-emoji-json": "^0.8.0",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.1",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "tar": "^7.5.9",
    "tmp": "^0.2.5",
    "webpack-dev-server": "^5.2.3",
    "serialize-javascript": "^7.0.3",
    "minimatch": "^9.0.7",
    "rollup": "^4.59.0"
  },
  "optionalDependencies": {
    "@noble/hashes": "^2.0.1"
  }
}
