{
  "name": "@concordvoice/desktop",
  "productName": "ConcordVoice",
  "version": "0.1.20",
  "description": "Concord Voice Desktop Client - Privacy-first voice communication",
  "main": "dist/main/main.js",
  "author": "Concord Voice Team",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "npm run prebuild && npm run build:preload && tsc -p tsconfig.main.json && NODE_ENV=development electron-forge start",
    "prebuild": "tsx scripts/generate-sentry-config.ts",
    "build": "npm run build:renderer && npm run build:preload && npm run build:main",
    "build:renderer": "vite build",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:main": "tsc -p tsconfig.main.json",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "postinstall": "bash scripts/patch-electron-plist.sh || true",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "preview:splash": "npm run build:main && electron dist/main/splashPreview.js"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@sentry/electron": "^7.11.0",
    "@sentry/react": "^10.48.0",
    "electron-squirrel-startup": "^1.0.0",
    "electron-updater": "^6.8.3",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.7.0",
    "mediasoup-client": "^3.18.7",
    "minisearch": "^7.2.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "socket.io-client": "^4.8.3",
    "use-sync-external-store": "^1.6.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-squirrel": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@playwright/test": "^1.59.1",
    "@reforged/maker-appimage": "^5.2.0",
    "@sentry/vite-plugin": "^5.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/use-sync-external-store": "^1.5.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-istanbul": "^4.1.3",
    "@vitest/coverage-v8": "^4.1.0",
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^17.0.0",
    "jsdom": "^29.0.2",
    "msw": "^2.13.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "unicode-emoji-json": "^0.8.0",
    "vite": "^8.0.7",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "tar": "^7.5.11",
    "@tootallnate/once": "^3.0.1",
    "tmp": "^0.2.5",
    "serialize-javascript": "^7.0.3",
    "minimatch": "^9.0.7",
    "rollup": "^4.59.0"
  },
  "optionalDependencies": {
    "@noble/hashes": "^2.0.1"
  }
}
