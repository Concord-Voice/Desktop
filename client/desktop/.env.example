# Concord Desktop Client - Environment Variables Template
# Copy this file to .env for local development

# API Endpoints
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/api/v1/ws

# Environment
VITE_ENVIRONMENT=development

# Feature Flags
VITE_ENABLE_E2EE=true
VITE_ENABLE_VOICE=false
VITE_ENABLE_VIDEO=false

# Logging
VITE_LOG_LEVEL=debug

# Optional: Analytics (disabled in dev)
VITE_ANALYTICS_ENABLED=false
