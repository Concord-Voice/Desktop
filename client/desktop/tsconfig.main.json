{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node10",
    "outDir": "./dist/main",
    "rootDir": "./src/main",
    "lib": ["ES2022"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/main/**/*"],
  "exclude": ["node_modules", "dist", "src/renderer"]
}
